# ── Porla Backend — muhit o'zgaruvchilari namunasi ──
# Bu faylni .env ga nusxalang va qiymatlarni to'ldiring.
# DIQQAT: .env faylini hech qachon git'ga commit qilmang!

# ── Majburiy ──
MONGODB_URI=mongodb://localhost:27017/porla
JWT_SECRET=change_me_to_a_long_random_string

# ── Tavsiya etiladi ──
ADMIN_KEY=change_me_admin_key
FRONTEND_URL=http://localhost:3000

# ── Ixtiyoriy ──
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug
JWT_EXPIRES=30d
JWT_REFRESH_EXPIRES=90d
PUBLIC_API_URL=

# Bootstrap admin (autoSeed)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Rate limiting (ixtiyoriy override)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_GENERAL_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=1000
RATE_LIMIT_QNA_WINDOW_MS=900000
RATE_LIMIT_QNA_MAX=30

# MongoDB connection pooling (ixtiyoriy)
MONGO_MAX_POOL=20
MONGO_MIN_POOL=2
MONGO_SERVER_SELECTION_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000

# Redis (ixtiyoriy — berilsa cache va token blacklist Redis'da saqlanadi)
REDIS_URL=

# PM2
PM2_INSTANCES=max

# Telegram bot (ixtiyoriy)
BOT_TOKEN=
ADMIN_IDS=

# Video storage: local | s3
VIDEO_STORAGE=local
# S3 (VIDEO_STORAGE=s3 bo'lganda)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
